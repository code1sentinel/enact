{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyS3Deletes",
      "Effect": "Deny",
      "Action": "s3:DeleteBucket",
      "Resource": "*"
    },
    {
      "Sid": "PreventPasswordPolicyDelete",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteAccountPasswordPolicy",
        "iam:UpdateAccountPasswordPolicy"
      ],
      "Resource": "*"
    }
  ]
}
