{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grcengineering.club/ns/enact/evidence/envelope-1.0.schema.json",
  "title": "Enact evidence envelope 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enact_evidence",
    "id",
    "collected_at",
    "collector",
    "subject",
    "payload_type",
    "payload_version",
    "payload"
  ],
  "properties": {
    "enact_evidence": {
      "const": "1.0",
      "description": "Envelope version. Unknown versions fail closed."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id referenced from OSCAL observations. Not fetched."
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the source was collected, not when Enact ran."
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["manual", "adapter", "sample", "legacy"] }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "environment": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "Local path or opaque id. Enact never fetches this.",
      "properties": {
        "system": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "payload_type": {
      "type": "string",
      "minLength": 1,
      "description": "Enact-owned type id, for example enact.iam.account-policy."
    },
    "payload_version": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "Validated separately against the payload type schema."
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "integrity": {
      "type": "object",
      "description": "Reserved for later signing and attestations."
    }
  }
}
